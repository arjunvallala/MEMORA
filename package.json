{
  "name": "memora",
  "version": "1.0.0",
  "private": true,
  "description": "MEMORA - Different minds. One memory. Multi-LLM persistent memory workspace powered by Hindsight.",
  "scripts": {
    "setup": "npm install && npm run build --prefix shared && npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "build": "npm run build --prefix shared && npm run build --prefix backend && npm run build --prefix frontend",
    "start": "npm run start --prefix backend",
    "test": "npm run test --prefix backend",
    "demo:reset": "npm run demo:reset --prefix backend"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@openrouter/sdk": "^0.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "groq-sdk": "^0.9.0",
    "openai": "^4.85.4",
    "serverless-http": "^3.2.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/sqlite3": "^3.1.11",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  }
}
